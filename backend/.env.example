# Azure Cloud API Service Principal Credentials (Sample Template)
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_OBJECT_ID=your-azure-object-id

# Default Azure Resource Group & Location
AZURE_RESOURCE_GROUP=your-resource-group-name
AZURE_LOCATION=centralindia

# Operational Mode: 'azure' for real cloud, 'demo' for mock, 'auto' to auto-detect
AZURE_MODE=auto
